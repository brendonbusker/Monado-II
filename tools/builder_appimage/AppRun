#!/bin/sh
# Monado II's standalone authored frontend: no adjacent build or host Python.
set -eu
unset PYTHONHOME PYTHONPATH LD_PRELOAD SDL_DYNAMIC_API
: "${APPDIR:?AppImage runtime did not provide APPDIR}"
export LD_LIBRARY_PATH="$APPDIR/usr/python/lib:$APPDIR/usr/lib"
exec "$APPDIR/usr/python/bin/python3.14" -I -B "$APPDIR/usr/lib/monado-ii/builder_bootstrap.py" "$@"
